# Path to the changelog file containing your database migrations
changeLogFile=changelog/changelog-master.sql

# The JDBC connection URL for your MySQL database
url=jdbc:mysql://localhost:3306/your_database_name

# Database authentication credentials
username=your_user
password=your_password

# The driver class name (Use com.mysql.cj.jdbc.Driver for modern MySQL 8.x+)
driver=com.mysql.cj.jdbc.Driver