{
    "name": "slim/slim-skeleton",
    "description": "A Slim Framework skeleton application for rapid development",
    "keywords": [
        "microframework",
        "rest",
        "router",
        "psr7"
    ],
    "homepage": "http://github.com/slimphp/Slim-Skeleton",
    "license": "MIT",
    "authors": [
        {
            "name": "Josh Lockhart",
            "email": "info@joshlockhart.com",
            "homepage": "http://www.joshlockhart.com/"
        },
        {
            "name": "Pierre Berube",
            "email": "pierre@lgse.com",
            "homepage": "http://www.lgse.com/"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-json": "*",
        "monolog/monolog": "^3.10",
        "php-di/php-di": "^6.4",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15.3",
        "sqids/sqids": "^0.5.0",
        "twbs/bootstrap": "^5.3",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "jangregor/phpstan-prophecy": "^1.0.2",
        "phpspec/prophecy-phpunit": "^2.5",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^1.12.34",
        "phpunit/phpunit": "^9.6.36",
        "squizlabs/php_codesniffer": "^3.13.6"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "autoload": {
        "files": [
            "app/Functions.php"
        ],
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public",
        "test": "phpunit",
        "post-update-cmd": [
            "php scripts/sync-bootstrap.php"
        ]
    }
}
