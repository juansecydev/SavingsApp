{% extends "base.html.twig" %}

{% block title %}
    Perfil de {{ profile.first_name }} {{ profile.last_name }}
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="resources/js/libs/Filepond/filepond.css">
    <link rel="stylesheet" href="resources/css/FilepondProfile.css">
    <link rel="stylesheet" href="resources/js/libs/Filepond/plugins/filepond-preview.css">
{% endblock %}

{% block content %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h1 class="h3 mb-0">Mi perfil</h1>
                            <a href="{{ url_for('welcome') }}" class="btn btn-outline-secondary">Volver</a>
                        </div>

                        {% if errors is defined and errors is not empty %}
                            <div class="alert alert-danger" role="alert">
                                <strong>Por favor corrige los siguientes errores:</strong>
                                <ul class="mb-0 mt-2">
                                    {% for field, messages in errors %}
                                        {% for message in messages %}
                                            <li>{{ message }}</li>
                                        {% endfor %}
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        {% if success is defined and success %}
                            <div class="alert alert-success" role="alert">{{ success }}</div>
                        {% endif %}

                        <form method="post" action="{{ url_for('profile.update') }}">
                            <div class="mb-3">
                                <label for="first_name" class="form-label">Nombres</label>
                                <input type="text" id="first_name" name="first_name" class="form-control" value="{{ profile.first_name }}" required>
                            </div>

                            <div class="mb-3">
                                <label for="last_name" class="form-label">Apellidos</label>
                                <input type="text" id="last_name" name="last_name" class="form-control" value="{{ profile.last_name }}" required>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">Correo electrónico</label>
                                <input type="email" id="email" name="email" class="form-control" value="{{ profile.email }}" required>
                            </div>

                            <div class="mb-3">
                                <label for="profile_picture_input" class="form-label">Foto de perfil</label>
                                <div class="profile-picture-upload">
                                    <input
                                        type="file"
                                        id="profile_picture_input"
                                        accept="image/png,image/jpeg"
                                    >
                                </div>
                                <input
                                    type="text"
                                    id="profile_picture"
                                    name="profile_picture"
                                    class="form-control"
                                    value="{{ profile.profile_picture|default('') }}"
                                    readonly
                                >
                            </div>

                            <div class="mb-3">
                                <label for="role_name" class="form-label">Rol</label>
                                <p id="role_name" class="form-control-plaintext">{{ profile.role_name }}</p>
                            </div>

                            <input type="hidden" name="user_id" value="{{ profile.id }}">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

                            <button type="submit" class="btn btn-primary">Actualizar datos</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% block javascript %}
    <script src="resources/js/libs/Filepond/plugins/filepond-exif-orientation.js"></script>
    <script src="resources/js/libs/Filepond/plugins/filepond-img-resize.js"></script>
    <script src="resources/js/libs/Filepond/plugins/filepond-img-transform.js"></script>
    <script src="resources/js/libs/Filepond/plugins/filepond-img-validate-size.js"></script>
    <script src="resources/js/libs/Filepond/plugins/filepond-preview.js"></script>
    <script src="resources/js/libs/Filepond/plugins/filepond-type-validation.js"></script>
    <script src="resources/js/libs/Filepond/plugins/filepond-validate-size.js"></script>
    <script src="resources/js/libs/Filepond/plugins/filepond-crop.js"></script>
    <script src="resources/js/libs/Filepond/filepond.js"></script>
    <script src="resources/js/modules/user/FilepondProfile.js"></script>
{% endblock %}