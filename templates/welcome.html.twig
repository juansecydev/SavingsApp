{% extends "base.html.twig" %}

{% block title %}
    Bienvenido {{ user.user_name }} {{ user.user_lastname }}
{% endblock %}

{% block content %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="d-flex align-items-center gap-3">
                                {# The endpoint serves the custom image or default avatar and enables private browser caching. #}
                                <img
                                    src="{{ url_for('profile-picture.show', {'id': user.profile_picture|default('default')}) }}"
                                    alt="Foto de perfil de {{ user.user_name }} {{ user.user_lastname }}"
                                    class="rounded-circle"
                                    width="100"
                                    height="100"
                                >
                                <div>
                                <h1 class="h3">Bienvenido/a, {{ user.user_name }} {{ user.user_lastname }}</h1>
                                <p class="text-muted">Has iniciado sesión correctamente.</p>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="{{ url_for('profile') }}" class="btn btn-outline-primary">Mi perfil</a>
                                <form method="POST" action="{{ url_for('logout') }}">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <button type="submit" class="btn btn-outline-danger">Cerrar sesión</button>
                                </form>
                            </div>
                        </div>
                        <!-- Sección de Cuentas -->
                        <div class="mt-4">
                            {% if account_delete_failed %}
                                <div class="alert alert-danger" role="alert">
                                    No fue posible eliminar la cuenta. Inténtalo nuevamente.
                                </div>
                            {% endif %}
                            {% if accounts|length > 0 %}
                                <!-- Mostrar cuentas existentes -->
                                <h5 class="mb-3">Mis Cuentas</h5>
                                <div class="row">
                                    {% for account in accounts %}
                                        <div class="col-12 col-md-6 mb-3">
                                            <div class="card border-primary">
                                                <div class="card-body">
                                                    <h6 class="card-title">{{ account.account_name }}</h6>
                                                    <div class="d-flex gap-2">
                                                        <a href="{{ url_for('account.detail', {'id': account.account_id}) }}" class="btn btn-sm btn-outline-primary">Ver detalles</a>
                                                        <button
                                                            type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteAccountModal{{ account.account_id }}"
                                                        >
                                                            Eliminar
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div
                                            class="modal fade"
                                            id="deleteAccountModal{{ account.account_id }}"
                                            tabindex="-1"
                                            aria-labelledby="deleteAccountModalLabel{{ account.account_id }}"
                                            aria-hidden="true"
                                        >
                                            <div class="modal-dialog modal-dialog-centered modal-sm">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="deleteAccountModalLabel{{ account.account_id }}">
                                                            Eliminar cuenta
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p>¿Seguro que deseas eliminar la cuenta <strong>{{ account.account_name }}</strong>?</p>
                                                        <p class="mb-0 text-danger">
                                                            También se eliminarán todas sus transacciones. Esta acción es permanente y no se puede deshacer.
                                                        </p>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                        <form method="POST" action="{{ url_for('account.delete.form', {'id': account.account_id}) }}">
                                                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                                            <button type="submit" class="btn btn-danger">Eliminar cuenta</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                                <div class="mt-3">
                                    <a href="/accounts" class="btn btn-primary">Agregar nueva cuenta</a>
                                </div>
                            {% else %}
                                <!-- Mostrar sección de creación de cuenta -->
                                <div class="p-4 bg-info bg-opacity-10 rounded border border-info">
                                    <div class="text-center">
                                        <h5 class="mb-3">No tienes cuentas registradas</h5>
                                        <p class="text-muted mb-4">Comienza a organizar tus ahorros creando tu primera cuenta.</p>
                                        <a href="{{ url_for('account') }}" class="btn btn-primary btn-lg">
                                            <i class="bi bi-plus-circle"></i> Crear mi primera cuenta
                                        </a>
                                    </div>
                                </div>
                            {% endif %}
                        </div>

                        <div class="mt-4 p-3 bg-light rounded">
                            <h5>Información</h5>
                            <p>Este es tu panel de bienvenida. Aquí puedes ver tus cuentas de ahorro y gestionar tus transacciones.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
