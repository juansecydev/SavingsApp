<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SavingsApp{% endblock %}</title>
    {# CSS global #}
    <link rel="stylesheet" href="/resources/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/resources/bootstrap/icons/bootstrap-icons.min.css">
    {# CSS personalized block #}
    {% block stylesheets %}
    {% endblock %}
    <link rel="icon" href="/resources/img/favicon.ico" type="image/x-icon">
</head>
<body>
<header>
    <div class="container-fluid d-flex justify-content-end p-3">
        <button id="theme-toggle" class="btn btn-outline-secondary" type="button" aria-label="Cambiar a modo claro">
            <i class="bi bi-brightness-high-fill" aria-hidden="true"></i>
        </button>
    </div>
</header>
<main>
    {% block content %}{% endblock %}
</main>
{# JS global #}
<script src="/resources/bootstrap/js/bootstrap.min.js"></script>
<script src="/resources/js/themeMode.js"></script>
{# JS personalized block #}
{% block javascript %}
{% endblock %}
</body>
</html>